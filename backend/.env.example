# Configuration Settings (Tùy chọn - Hệ thống đã có sẵn giá trị mặc định)
PROJECT_NAME="Language Center Management System (Hệ thống Quản lý Trung tâm Ngoại ngữ)"
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production-language-center-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite mặc định (chạy ngay không cần cài DB server)
DATABASE_URL=sqlite:///./language_center.db

# Hoặc PostgreSQL khi triển khai thực tế:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/language_center

# Cấu hình gửi Email OTP qua Gmail SMTP (Tùy chọn)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="SMART-EDU LMS"
SMTP_TLS=True

