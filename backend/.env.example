# Configuration Settings (Tùy chọn - Hệ thống đã có sẵn giá trị mặc định)
PROJECT_NAME="Language Center Management System (Hệ thống Quản lý Trung tâm Ngoại ngữ)"
API_V1_STR=/api/v1
SECRET_KEY=super-secret-key-change-in-production-language-center-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite mặc định (chạy ngay không cần cài DB server)
