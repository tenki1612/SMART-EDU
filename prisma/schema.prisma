generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BANG_DIEM {
  MaBangDiem    Int       @id @default(autoincrement())
  MaLopHoc      Int
  MaHocVien     Int
  DiemChuyenCan Float?
  DiemGiuaKy    Float?
  DiemCuoiKy    Float?
  DiemTongKet   Float?
  KetQua        String?   @db.VarChar(50)
  DaKhoaSo      Boolean?
  GhiChu        String?
  NgayTao       DateTime? @db.Timestamp(6)
  NgayCapNhat   DateTime? @db.Timestamp(6)
  DaXoa         Boolean?
  HOC_VIEN      HOC_VIEN  @relation(fields: [MaHocVien], references: [MaHocVien], onDelete: NoAction, onUpdate: NoAction)
  LOP_HOC       LOP_HOC   @relation(fields: [MaLopHoc], references: [MaLopHoc], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaBangDiem], map: "ix_BANG_DIEM_MaBangDiem")
}

model BUOI_HOC {
  MaBuoiHoc   Int        @id @default(autoincrement())
  MaLopHoc    Int
  MaPhongHoc  Int
  MaGiangVien Int
  NgayHoc     DateTime   @db.Date
  GioBatDau   String     @db.VarChar(10)
  GioKetThuc  String     @db.VarChar(10)
  CaHoc       String?    @db.VarChar(100)
  DaXacNhan   Boolean?
  TrangThai   String?    @db.VarChar(50)
  NgayTao     DateTime?  @db.Timestamp(6)
  NgayCapNhat DateTime?  @db.Timestamp(6)
  DaXoa       Boolean?
  GIANG_VIEN  GIANG_VIEN @relation(fields: [MaGiangVien], references: [MaGiangVien], onDelete: NoAction, onUpdate: NoAction)
  LOP_HOC     LOP_HOC    @relation(fields: [MaLopHoc], references: [MaLopHoc], onDelete: NoAction, onUpdate: NoAction)
  PHONG_HOC   PHONG_HOC  @relation(fields: [MaPhongHoc], references: [MaPhongHoc], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaBuoiHoc], map: "ix_BUOI_HOC_MaBuoiHoc")
}

model GIANG_VIEN {
  MaGiangVien   Int        @id @default(autoincrement())
  MaNguoiDung   Int        @unique
  MaSoGiangVien String     @unique(map: "ix_GIANG_VIEN_MaSoGiangVien") @db.VarChar(50)
  ChuyenMon     String?    @db.VarChar(100)
  HocVi         String?    @db.VarChar(100)
  TrangThai     String?    @db.VarChar(50)
  NgayTao       DateTime?  @db.Timestamp(6)
  NgayCapNhat   DateTime?  @db.Timestamp(6)
  DaXoa         Boolean?
  BUOI_HOC      BUOI_HOC[]
  NGUOI_DUNG    NGUOI_DUNG @relation(fields: [MaNguoiDung], references: [MaNguoiDung], onDelete: Cascade, onUpdate: NoAction)
  LOP_HOC       LOP_HOC[]

  @@index([MaGiangVien], map: "ix_GIANG_VIEN_MaGiangVien")
}

model HOC_VIEN {
  MaHocVien           Int                   @id @default(autoincrement())
  MaNguoiDung         Int                   @unique
  MaSoHocVien         String                @unique(map: "ix_HOC_VIEN_MaSoHocVien") @db.VarChar(50)
  NgaySinh            DateTime?             @db.Date
  DiaChi              String?               @db.VarChar(255)
  TrangThai           String?               @db.VarChar(50)
  NgayTao             DateTime?             @db.Timestamp(6)
  NgayCapNhat         DateTime?             @db.Timestamp(6)
  DaXoa               Boolean?
  BANG_DIEM           BANG_DIEM[]
  NGUOI_DUNG          NGUOI_DUNG            @relation(fields: [MaNguoiDung], references: [MaNguoiDung], onDelete: Cascade, onUpdate: NoAction)
  HOC_VIEN_LOP_HOC    HOC_VIEN_LOP_HOC[]
  PHU_HUYNH_HOC_VIEN  PHU_HUYNH_HOC_VIEN[]
  TIEN_TRINH_KHOA_HOC TIEN_TRINH_KHOA_HOC[]
  YEU_CAU_DANG_KY     YEU_CAU_DANG_KY[]

  @@index([MaHocVien], map: "ix_HOC_VIEN_MaHocVien")
}

model HOC_VIEN_LOP_HOC {
  MaHV_LH      Int       @id @default(autoincrement())
  MaLopHoc     Int
  MaHocVien    Int
  NgayVaoLop   DateTime? @db.Timestamp(6)
  TrangThaiHoc String?   @db.VarChar(50)
  NgayTao      DateTime? @db.Timestamp(6)
  NgayCapNhat  DateTime? @db.Timestamp(6)
  DaXoa        Boolean?
  HOC_VIEN     HOC_VIEN  @relation(fields: [MaHocVien], references: [MaHocVien], onDelete: NoAction, onUpdate: NoAction)
  LOP_HOC      LOP_HOC   @relation(fields: [MaLopHoc], references: [MaLopHoc], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaHV_LH], map: "ix_HOC_VIEN_LOP_HOC_MaHV_LH")
}

model KHOA_HOC {
  MaKhoaHoc                                                           Int                   @id @default(autoincrement())
  MaSoKhoaHoc                                                         String                @unique(map: "ix_KHOA_HOC_MaSoKhoaHoc") @db.VarChar(50)
  TenKhoaHoc                                                          String                @db.VarChar(150)
  MoTa                                                                String?
  TrinhDoMucTieu                                                      String                @db.VarChar(100)
  ThoiLuongTuan                                                       Int?
  HocPhi                                                              Float?
  TrangThai                                                           Boolean?
  NgayTao                                                             DateTime?             @db.Timestamp(6)
  NgayCapNhat                                                         DateTime?             @db.Timestamp(6)
  DaXoa                                                               Boolean?
  LOP_HOC                                                             LOP_HOC[]
  TIEN_TRINH_KHOA_HOC_TIEN_TRINH_KHOA_HOC_MaKhoaHocHienTaiToKHOA_HOC  TIEN_TRINH_KHOA_HOC[] @relation("TIEN_TRINH_KHOA_HOC_MaKhoaHocHienTaiToKHOA_HOC")
  TIEN_TRINH_KHOA_HOC_TIEN_TRINH_KHOA_HOC_MaKhoaHocTiepTheoToKHOA_HOC TIEN_TRINH_KHOA_HOC[] @relation("TIEN_TRINH_KHOA_HOC_MaKhoaHocTiepTheoToKHOA_HOC")

  @@index([MaKhoaHoc], map: "ix_KHOA_HOC_MaKhoaHoc")
}

model LOP_HOC {
  MaLopHoc         Int                @id @default(autoincrement())
  MaSoLop          String             @unique(map: "ix_LOP_HOC_MaSoLop") @db.VarChar(50)
  MaKhoaHoc        Int
  MaGiangVien      Int?
  SiSoToiDa        Int?
  SiSoHienTai      Int?
  NgayBatDau       DateTime?          @db.Date
  NgayKetThuc      DateTime?          @db.Date
  TrangThai        String?            @db.VarChar(50)
  NgayTao          DateTime?          @db.Timestamp(6)
  NgayCapNhat      DateTime?          @db.Timestamp(6)
  DaXoa            Boolean?
  BANG_DIEM        BANG_DIEM[]
  BUOI_HOC         BUOI_HOC[]
  HOC_VIEN_LOP_HOC HOC_VIEN_LOP_HOC[]
  GIANG_VIEN       GIANG_VIEN?        @relation(fields: [MaGiangVien], references: [MaGiangVien], onDelete: NoAction, onUpdate: NoAction)
  KHOA_HOC         KHOA_HOC           @relation(fields: [MaKhoaHoc], references: [MaKhoaHoc], onDelete: NoAction, onUpdate: NoAction)
  YEU_CAU_DANG_KY  YEU_CAU_DANG_KY[]

  @@index([MaLopHoc], map: "ix_LOP_HOC_MaLopHoc")
}

model NGUOI_DUNG {
  MaNguoiDung         Int                   @id @default(autoincrement())
  TenDangNhap         String                @unique(map: "ix_NGUOI_DUNG_TenDangNhap") @db.VarChar(50)
  Email               String                @unique(map: "ix_NGUOI_DUNG_Email") @db.VarChar(100)
  HoTen               String                @db.VarChar(100)
  MatKhau             String                @db.VarChar(255)
  VaiTro              roleenum
  SoDienThoai         String?               @db.VarChar(20)
  AnhDaiDien          String?               @db.VarChar(500)
  TrangThai           Boolean?
  SoLanDangNhapSai    Int
  ThoiGianKhoa        DateTime?             @db.Timestamp(6)
  MaXacThucOTP        String?               @db.VarChar(100)
  HanXacThucOTP       DateTime?             @db.Timestamp(6)
  NgayTao             DateTime?             @db.Timestamp(6)
  NgayCapNhat         DateTime?             @db.Timestamp(6)
  DaXoa               Boolean?
  GIANG_VIEN          GIANG_VIEN?
  HOC_VIEN            HOC_VIEN?
  PHU_HUYNH_HOC_VIEN  PHU_HUYNH_HOC_VIEN[]
  TIEN_TRINH_KHOA_HOC TIEN_TRINH_KHOA_HOC[]
  YEU_CAU_DANG_KY     YEU_CAU_DANG_KY[]

  @@index([MaNguoiDung], map: "ix_NGUOI_DUNG_MaNguoiDung")
}

model PHONG_HOC {
  MaPhongHoc  Int        @id @default(autoincrement())
  MaSoPhong   String     @unique(map: "ix_PHONG_HOC_MaSoPhong") @db.VarChar(50)
  ToaNha      String?    @db.VarChar(50)
  SucChua     Int?
  TrangThai   String?    @db.VarChar(50)
  NgayTao     DateTime?  @db.Timestamp(6)
  NgayCapNhat DateTime?  @db.Timestamp(6)
  DaXoa       Boolean?
  BUOI_HOC    BUOI_HOC[]

  @@index([MaPhongHoc], map: "ix_PHONG_HOC_MaPhongHoc")
}

model PHU_HUYNH_HOC_VIEN {
  MaPH_HV        Int        @id @default(autoincrement())
  MaNguoiDung_PH Int
  MaHocVien      Int
  QuanHe         String?    @db.VarChar(50)
  NgayTao        DateTime?  @db.Timestamp(6)
  NgayCapNhat    DateTime?  @db.Timestamp(6)
  DaXoa          Boolean?
  HOC_VIEN       HOC_VIEN   @relation(fields: [MaHocVien], references: [MaHocVien], onDelete: NoAction, onUpdate: NoAction)
  NGUOI_DUNG     NGUOI_DUNG @relation(fields: [MaNguoiDung_PH], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaPH_HV], map: "ix_PHU_HUYNH_HOC_VIEN_MaPH_HV")
}

model TIEN_TRINH_KHOA_HOC {
  MaTienTrinh                                              Int         @id @default(autoincrement())
  MaHocVien                                                Int
  MaKhoaHocHienTai                                         Int
  MaKhoaHocTiepTheo                                        Int
  DuDieuKien                                               Boolean?
  DaXacNhan                                                Boolean?
  MaNguoiXacNhan                                           Int?
  NgayXacNhan                                              DateTime?   @db.Timestamp(6)
  GhiChu                                                   String?
  NgayTao                                                  DateTime?   @db.Timestamp(6)
  NgayCapNhat                                              DateTime?   @db.Timestamp(6)
  DaXoa                                                    Boolean?
  HOC_VIEN                                                 HOC_VIEN    @relation(fields: [MaHocVien], references: [MaHocVien], onDelete: NoAction, onUpdate: NoAction)
  KHOA_HOC_TIEN_TRINH_KHOA_HOC_MaKhoaHocHienTaiToKHOA_HOC  KHOA_HOC    @relation("TIEN_TRINH_KHOA_HOC_MaKhoaHocHienTaiToKHOA_HOC", fields: [MaKhoaHocHienTai], references: [MaKhoaHoc], onDelete: NoAction, onUpdate: NoAction)
  KHOA_HOC_TIEN_TRINH_KHOA_HOC_MaKhoaHocTiepTheoToKHOA_HOC KHOA_HOC    @relation("TIEN_TRINH_KHOA_HOC_MaKhoaHocTiepTheoToKHOA_HOC", fields: [MaKhoaHocTiepTheo], references: [MaKhoaHoc], onDelete: NoAction, onUpdate: NoAction)
  NGUOI_DUNG                                               NGUOI_DUNG? @relation(fields: [MaNguoiXacNhan], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaTienTrinh], map: "ix_TIEN_TRINH_KHOA_HOC_MaTienTrinh")
}

model YEU_CAU_DANG_KY {
  MaYeuCau     Int         @id @default(autoincrement())
  MaHocVien    Int
  MaLopHoc     Int
  NgayYeuCau   DateTime?   @db.Timestamp(6)
  TrangThai    String?     @db.VarChar(50)
  GhiChu       String?
  LyDoTuChoi   String?
  MaNguoiDuyet Int?
  NgayDuyet    DateTime?   @db.Timestamp(6)
  NgayTao      DateTime?   @db.Timestamp(6)
  NgayCapNhat  DateTime?   @db.Timestamp(6)
  DaXoa        Boolean?
  HOC_VIEN     HOC_VIEN    @relation(fields: [MaHocVien], references: [MaHocVien], onDelete: NoAction, onUpdate: NoAction)
  LOP_HOC      LOP_HOC     @relation(fields: [MaLopHoc], references: [MaLopHoc], onDelete: NoAction, onUpdate: NoAction)
  NGUOI_DUNG   NGUOI_DUNG? @relation(fields: [MaNguoiDuyet], references: [MaNguoiDung], onDelete: NoAction, onUpdate: NoAction)

  @@index([MaYeuCau], map: "ix_YEU_CAU_DANG_KY_MaYeuCau")
}

enum roleenum {
  ADMIN
  ACADEMIC_STAFF
  TEACHER
  STUDENT
  PARENT
}
