generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 1. Bảng User: Tài khoản người dùng & bảo mật đăng nhập
model User {
  username              String              @unique(map: "ix_users_username") @db.VarChar(50)
  email                 String              @unique(map: "ix_users_email") @db.VarChar(100)
  fullName              String              @map("full_name") @db.VarChar(100)
  hashedPassword        String              @map("hashed_password") @db.VarChar(255)
  role                  roleenum
  phone                 String?             @db.VarChar(20)
  avatarUrl             String?             @map("avatar_url") @db.VarChar(500)
  isActive              Boolean?            @map("is_active")
  failedLoginAttempts   Int                 @map("failed_login_attempts")
  lockedUntil           DateTime?           @map("locked_until") @db.Timestamp(6)
  resetToken            String?             @map("reset_token") @db.VarChar(100)
  resetTokenExpiresAt   DateTime?           @map("reset_token_expires_at") @db.Timestamp(6)
  id                    Int                 @id @default(autoincrement())
  createdAt             DateTime?           @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted             Boolean?            @map("is_deleted")
  confirmedProgressions CourseProgression[] @relation("ConfirmedByUser")
  reviewedEnrollments   EnrollmentRequest[] @relation("ReviewedByUser")
  parentLinks           ParentStudent[]     @relation("ParentUser")
  studentProfile        Student?
  teacherProfile        Teacher?

  @@index([id], map: "ix_users_id")
  @@map("users")
}

/// 2. Bảng Course: Chương trình đào tạo & Chuẩn đầu ra
model Course {
  code                String              @unique(map: "ix_courses_code") @db.VarChar(50)
  title               String              @db.VarChar(150)
  description         String?
  targetLevel         String              @map("target_level") @db.VarChar(100)
  durationWeeks       Int?                @map("duration_weeks")
  fee                 Float?
  isActive            Boolean?            @map("is_active")
  id                  Int                 @id @default(autoincrement())
  createdAt           DateTime?           @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted           Boolean?            @map("is_deleted")
  classes             Class[]
  currentProgressions CourseProgression[] @relation("CurrentCourse")
  nextProgressions    CourseProgression[] @relation("NextCourse")

  @@index([id], map: "ix_courses_id")
  @@map("courses")
}

/// 3. Bảng Student: Hồ sơ cá nhân của học viên (1-1 với User)
model Student {
  userId             Int                 @unique @map("user_id")
  studentCode        String              @unique(map: "ix_students_student_code") @map("student_code") @db.VarChar(50)
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  address            String?             @db.VarChar(255)
  status             String?             @db.VarChar(50)
  id                 Int                 @id @default(autoincrement())
  createdAt          DateTime?           @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted          Boolean?            @map("is_deleted")
  classEnrollments   ClassStudent[]
  progressions       CourseProgression[]
  enrollmentRequests EnrollmentRequest[]
  grades             GradeRecord[]
  parents            ParentStudent[]
  user               User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_students_id")
  @@map("students")
}

/// 4. Bảng Teacher: Hồ sơ chuyên môn của giáo viên (1-1 với User)
model Teacher {
  userId      Int               @unique @map("user_id")
  teacherCode String            @unique(map: "ix_teachers_teacher_code") @map("teacher_code") @db.VarChar(50)
  specialty   String?           @db.VarChar(100)
  degree      String?           @db.VarChar(100)
  status      String?           @db.VarChar(50)
  id          Int               @id @default(autoincrement())
  createdAt   DateTime?         @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime?         @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted   Boolean?          @map("is_deleted")
  classes     Class[]
  schedules   ScheduleSession[]
  user        User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_teachers_id")
  @@map("teachers")
}

/// 5. Bảng Classroom: Cơ sở vật chất & Sức chứa phòng học
model Classroom {
  roomCode  String            @unique(map: "ix_classrooms_room_code") @map("room_code") @db.VarChar(50)
  building  String?           @db.VarChar(50)
  capacity  Int?
  status    String?           @db.VarChar(50)
  id        Int               @id @default(autoincrement())
  createdAt DateTime?         @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?         @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted Boolean?          @map("is_deleted")
  schedules ScheduleSession[]

  @@index([id], map: "ix_classrooms_id")
  @@map("classrooms")
}

/// 6. Bảng Class: Quản lý lớp học, sĩ số & giáo viên phụ trách
model Class {
  classCode       String              @unique(map: "ix_classes_class_code") @map("class_code") @db.VarChar(50)
  courseId        Int                 @map("course_id")
  teacherId       Int?                @map("teacher_id")
  maxCapacity     Int?                @map("max_capacity")
  currentEnrolled Int?                @map("current_enrolled")
  startDate       DateTime?           @map("start_date") @db.Date
  endDate         DateTime?           @map("end_date") @db.Date
  status          String?             @db.VarChar(50)
  id              Int                 @id @default(autoincrement())
  createdAt       DateTime?           @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?           @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted       Boolean?            @map("is_deleted")
  students        ClassStudent[]
  course          Course              @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher         Teacher?            @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments     EnrollmentRequest[]
  grades          GradeRecord[]
  schedules       ScheduleSession[]

  @@index([id], map: "ix_classes_id")
  @@map("classes")
}

/// 7. Bảng ClassStudent: Danh sách thành viên lớp học (Many-to-Many Class & Student)
model ClassStudent {
  classId       Int       @map("class_id")
  studentId     Int       @map("student_id")
  enrolledAt    DateTime? @map("enrolled_at") @db.Timestamp(6)
  status        String?   @db.VarChar(50)
  id            Int       @id @default(autoincrement())
  createdAt     DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted     Boolean?  @map("is_deleted")
  enrolledClass Class     @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_class_students_id")
  @@map("class_students")
}

/// 8. Bảng EnrollmentRequest: Đăng ký & Xét duyệt ghi danh lớp học
model EnrollmentRequest {
  studentId       Int       @map("student_id")
  classId         Int       @map("class_id")
  requestDate     DateTime? @map("request_date") @db.Timestamp(6)
  status          String?   @db.VarChar(50)
  note            String?
  rejectionReason String?   @map("rejection_reason")
  reviewedBy      Int?      @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamp(6)
  id              Int       @id @default(autoincrement())
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted       Boolean?  @map("is_deleted")
  enrolledClass   Class     @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewer        User?     @relation("ReviewedByUser", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_enrollment_requests_id")
  @@map("enrollment_requests")
}

/// 9. Bảng ScheduleSession: Lịch học từng buổi, xếp phòng & giáo viên
model ScheduleSession {
  classId      Int       @map("class_id")
  classroomId  Int       @map("classroom_id")
  teacherId    Int       @map("teacher_id")
  sessionDate  DateTime  @map("session_date") @db.Date
  startTime    String    @map("start_time") @db.VarChar(10)
  endTime      String    @map("end_time") @db.VarChar(10)
  slotName     String?   @map("slot_name") @db.VarChar(50)
  isConfirmed  Boolean?  @map("is_confirmed")
  status       String?   @db.VarChar(50)
  id           Int       @id @default(autoincrement())
  createdAt    DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted    Boolean?  @map("is_deleted")
  sessionClass Class     @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  classroom    Classroom @relation(fields: [classroomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher      Teacher   @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_schedule_sessions_id")
  @@map("schedule_sessions")
}

/// 10. Bảng GradeRecord: Quản lý điểm số, đánh giá & khóa sổ điểm
model GradeRecord {
  classId         Int       @map("class_id")
  studentId       Int       @map("student_id")
  attendanceScore Float?    @map("attendance_score")
  midtermScore    Float?    @map("midterm_score")
  finalScore      Float?    @map("final_score")
  totalScore      Float?    @map("total_score")
  resultStatus    String?   @map("result_status") @db.VarChar(50)
  isConfirmed     Boolean?  @map("is_confirmed")
  note            String?
  id              Int       @id @default(autoincrement())
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted       Boolean?  @map("is_deleted")
  enrolledClass   Class     @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_grade_records_id")
  @@map("grade_records")
}

/// 11. Bảng CourseProgression: Lộ trình và thẩm định chuyển khóa học
model CourseProgression {
  studentId       Int       @map("student_id")
  currentCourseId Int       @map("current_course_id")
  nextCourseId    Int       @map("next_course_id")
  isEligible      Boolean?  @map("is_eligible")
  isConfirmed     Boolean?  @map("is_confirmed")
  confirmedBy     Int?      @map("confirmed_by")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamp(6)
  note            String?
  id              Int       @id @default(autoincrement())
  createdAt       DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted       Boolean?  @map("is_deleted")
  confirmer       User?     @relation("ConfirmedByUser", fields: [confirmedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentCourse   Course    @relation("CurrentCourse", fields: [currentCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextCourse      Course    @relation("NextCourse", fields: [nextCourseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_course_progressions_id")
  @@map("course_progressions")
}

/// 12. Bảng ParentStudent: Liên kết phụ huynh giám hộ học viên
model ParentStudent {
  parentUserId     Int       @map("parent_user_id")
  studentId        Int       @map("student_id")
  relationshipType String?   @map("relationship_type") @db.VarChar(50)
  id               Int       @id @default(autoincrement())
  createdAt        DateTime? @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  isDeleted        Boolean?  @map("is_deleted")
  parentUser       User      @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_parent_students_id")
  @@map("parent_students")
}

enum roleenum {
  ADMIN
  ACADEMIC_STAFF
  TEACHER
  STUDENT
  PARENT
}
